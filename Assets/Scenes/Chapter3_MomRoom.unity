--- !u!114 &1191200960
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1191200957}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b3c94b9158fe50b429b236d7b0322def, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MotherDialogueTrigger
  promptTalkToMom: {fileID: 882493684}
  momPanel: {fileID: 661732547}
  momDialogueText: {fileID: 1749881923}
  playerPanel: {fileID: 1431886219}
  playerDialogueText: {fileID: 1065156502}
  nextButton: {fileID: 433364880}
  skipButton: {fileID: 39331165}
  dialogueLines:
  - speaker: 1
    content: "M\u1EB9... ng\xE0y n\xE0o m\u1EB9 c\u0169ng chu\u1EA9n b\u1ECB c\u01A1m
      cho c\u1EA3 nh\xE0 nh\u01B0 v\u1EADy, m\u1EB9 c\xF3 m\u1EC7t kh\xF4ng?"
  - speaker: 0
    content: "M\u1EC7t ch\u1EE9. Nh\u01B0ng m\u1EB9 c\u1EE9 ngh\u0129 ch\u1EC9 c\u1EA7n
      c\xF3 m\u1ED9t b\u1EEFa c\u01A1m t\u1EED t\u1EBF th\xEC m\u1ECDi ng\u01B0\u1EDDi
      s\u1EBD mu\u1ED1n ng\u1ED3i l\u1EA1i."
  - speaker: 1
    content: "V\u1EADy m\xE0 nhi\u1EC1u l\u1EA7n con ch\u1EC9 \u0103n v\u1ED9i r\u1ED3i
      \u0111i, ch\u01B0a t\u1EEBng ngh\u0129 m\u1EB9 \u0111\xE3 ph\u1EA3i ch\u1EDD
      bao l\xE2u."
  - speaker: 0
    content: "M\u1EB9 c\u0169ng c\xF3 l\u1ED7i. M\u1EB9 bu\u1ED3n nh\u01B0ng kh\xF4ng
      n\xF3i, r\u1ED3i l\u1EA1i tr\xE1ch m\u1ECDi ng\u01B0\u1EDDi ch\u1EB3ng hi\u1EC3u
      m\xECnh."
  - speaker: 1
    content: "Con xin l\u1ED7i m\u1EB9. Con \u0111\xE3 quen v\u1EDBi vi\u1EC7c m\u1EB9
      lo m\u1ECDi th\u1EE9 n\xEAn qu\xEAn r\u1EB1ng m\u1EB9 c\u0169ng c\u1EA7n \u0111\u01B0\u1EE3c
      quan t\xE2m."
  - speaker: 0
    content: "M\u1EB9 c\u0169ng xin l\u1ED7i v\xEC \u0111\xE3 gi\u1EEF m\u1ECDi chuy\u1EC7n
      trong l\xF2ng. M\u1EB9 kh\xF4ng c\u1EA7n m\xE2m c\u01A1m \u0111\u1EA7y, ch\u1EC9
      mong c\u1EA3 nh\xE0 ch\u1ECBu ng\u1ED3i c\u1EA1nh nhau."
  - speaker: 1
    content: "T\u1EEB gi\u1EDD con s\u1EBD ph\u1EE5 m\u1EB9. M\u1EB9 \u0111\u1EEBng
      \xF4m h\u1EBFt m\u1ECDi vi\u1EC7c m\u1ED9t m\xECnh n\u1EEFa nh\xE9."
  - speaker: 0
    content: "\u1EEA. V\u1EADy h\xF4m nay hai m\u1EB9 con c\xF9ng d\u1ECDn b\xE0n,
      r\u1ED3i g\u1ECDi b\xE0 v\xE0 ba xu\u1ED1ng \u0103n c\u01A1m."
  panelMomAwake: {fileID: 17145128}
  panelMomHealed: {fileID: 1081875269}
