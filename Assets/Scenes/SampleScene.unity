  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5dc78a9aa9cb6c048b4c81a960d27578, type: 3}
  m_Name: 
  m_EditorClassIdentifier: EchoesInside.Narrative::SceneIntroDialogue
  dialoguePanel: {fileID: 783446516}
  speakerText: {fileID: 1057654339}
  contentText: {fileID: 726529622}
  playerController: {fileID: 8870777507034809775}
  speakerName: 
  lines:
  - "M\xECnh... \u0111ang \u1EDF \u0111\xE2u?"
  - "\u0110\xE2y l\xE0 nh\xE0 m\xECnh m\xE0. Nh\u01B0ng sao m\u1ECDi th\u1EE9 t\u1ED1i
    nh\u01B0 v\u1EADy?"
  - "Nh\u1EEFng c\xE1nh c\u1EEDa kia... c\xF3 g\xEC \u0111\xF3 kh\xF4ng gi\u1ED1ng
    b\xECnh th\u01B0\u1EDDng."
  - "N\u1EBFu \xE1nh s\xE1ng \u0111\xE3 bi\u1EBFn m\u1EA5t t\u1EEB b\xEAn trong,
    c\xF3 l\u1EBD m\xECnh ph\u1EA3i b\u1EAFt \u0111\u1EA7u t\u1EEB t\u1EEBng c\u0103n
    ph\xF2ng."
  initialDelay: 1.2
  playOnStart: 1
  playOncePerSession: 1
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls: []
