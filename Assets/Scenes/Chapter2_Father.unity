--- !u!114 &1457817960
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1457817958}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c7552087ff8e3ab468495daeed3e0925, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FatherDialogueTrigger
  talkToFatherNotice: {fileID: 1192390208}
  fatherButton: {fileID: 165301286}
  fatherPanel: {fileID: 429794487}
  fatherDialogueText: {fileID: 1185381316}
  playerPanel: {fileID: 1843135808}
  playerDialogueText: {fileID: 1136275137}
  nextButton: {fileID: 1282750060}
  skipButton: {fileID: 1464198609}
  dialogueLines:
  - speaker: 1
    content: "Ba... d\u1EA1o n\xE0y ba c\xF3 m\u1EC7t l\u1EAFm kh\xF4ng?"
  - speaker: 0
    content: "Sao h\xF4m nay con l\u1EA1i h\u1ECFi ba chuy\u1EC7n \u0111\xF3?"
  - speaker: 1
    content: "Con m\u1EDBi nh\u1EADn ra ba lu\xF4n c\u1ED1 t\u1EF1 gi\u1EA3i quy\u1EBFt
      m\u1ECDi th\u1EE9. Ba c\xE0ng im l\u1EB7ng, con c\xE0ng ngh\u0129 ba kh\xF4ng
      c\xF2n quan t\xE2m \u0111\u1EBFn gia \u0111\xECnh."
  - speaker: 0
    content: "Ba xin l\u1ED7i. Ba c\u1EE9 ngh\u0129 ch\u1EC9 c\u1EA7n l\xE0m vi\u1EC7c
      v\xE0 lo \u0111\u1EE7 cho m\u1ECDi ng\u01B0\u1EDDi l\xE0 \u0111\u01B0\u1EE3c,
      n\xEAn kh\xF4ng nh\u1EADn ra m\xECnh ng\xE0y c\xE0ng xa c\u1EA3 nh\xE0."
  - speaker: 1
    content: "Con c\u0169ng xin l\u1ED7i. Con ch\u1EC9 tr\xE1ch ba l\u1EA1nh nh\u1EA1t
      m\xE0 ch\u01B0a t\u1EEBng h\u1ECFi ba \u0111ang ph\u1EA3i ch\u1ECBu nh\u1EEFng
      g\xEC."
  - speaker: 0
    content: "Ba s\u1EE3 n\xF3i m\xECnh m\u1EC7t s\u1EBD khi\u1EBFn m\u1ECDi ng\u01B0\u1EDDi
      th\u1EA5t v\u1ECDng. Nh\u01B0ng gi\u1EEF im l\u1EB7ng ch\u1EC9 l\xE0m m\u1ECDi
      ng\u01B0\u1EDDi t\u1ED5n th\u01B0\u01A1ng h\u01A1n."
  - speaker: 1
    content: "Ba kh\xF4ng c\u1EA7n ph\u1EA3i g\xE1nh m\u1ED9t m\xECnh n\u1EEFa. T\u1EEB
      gi\u1EDD m\xECnh n\xF3i chuy\u1EC7n v\u1EDBi nhau nhi\u1EC1u h\u01A1n nh\xE9."
  - speaker: 0
    content: "\u1EEA. Ba s\u1EBD b\u1EAFt \u0111\u1EA7u t\u1EEB h\xF4m nay. M\xECnh
      v\u1EC1 v\u1EDBi m\u1ECDi ng\u01B0\u1EDDi th\xF4i, c\xF4ng vi\u1EC7c \u0111\u1EC3
      sau c\u0169ng \u0111\u01B0\u1EE3c."
  roomManager: {fileID: 1457817961}
  completionPanel: {fileID: 584164057}
