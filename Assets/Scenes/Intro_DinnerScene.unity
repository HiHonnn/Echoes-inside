  m_IsActive: 1
--- !u!114 &706915263
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 706915262}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0efbdf9fd45547d4bbdae5612da128e4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: EchoesInside.Narrative::StaticCutscenePlayer
  dialoguePanel: {fileID: 167812933}
  speakerText: {fileID: 1482740020}
  contentText: {fileID: 347555528}
  lines:
  - speakerName: "B\xE0: "
    content: "L\xE2u l\u1EAFm r\u1ED3i c\u1EA3 nh\xE0 m\xECnh m\u1EDBi ng\u1ED3i
      \u0111\xF4ng \u0111\u1EE7 th\u1EBF n\xE0y. \u0102n \u0111i c\xE1c con, th\u1EE9c
      \u0103n ngu\u1ED9i m\u1EA5t."
    anchor: {fileID: 889745936}
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    soundEffect: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - speakerName: "M\u1EB9:"
    content: "D\u1EA1, m\u1EB9 d\xF9ng c\u01A1m \u0111i \u1EA1. Anh c\u0169ng \u0103n
      \u0111i, em \u0111\xE3 h\xE2m l\u1EA1i m\u1EA5y l\u1EA7n r\u1ED3i."
    anchor: {fileID: 1108207947}
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    soundEffect: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - speakerName: 'Ba:'
    content: "Anh \u0111\xE3 b\u1EA3o m\u1ECDi ng\u01B0\u1EDDi kh\xF4ng c\u1EA7n
      ch\u1EDD. D\u1EA1o n\xE0y c\xF4ng vi\u1EC7c nhi\u1EC1u qu\xE1."
    anchor: {fileID: 1110933062}
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    soundEffect: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - speakerName: "M\u1EB9:"
    content: "Em kh\xF4ng tr\xE1ch anh b\u1EADn. Em ch\u1EC9 kh\xF4ng mu\u1ED1n b\u1EEFa
      n\xE0o c\u1EA3 nh\xE0 c\u0169ng \u0111\u1EE3i trong im l\u1EB7ng."
    anchor: {fileID: 1108207947}
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    soundEffect: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - speakerName: "Ch\u1ECB:"
    content: "C\xF3 ng\u1ED3i \u0111\xF4ng \u0111\u1EE7 th\xEC c\u0169ng \u0111\xE2u
      ai th\u1EADt s\u1EF1 n\xF3i chuy\u1EC7n v\u1EDBi nhau."
    anchor: {fileID: 940018621}
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    soundEffect: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - speakerName: "M\u1EB9:"
    content: "Con \u0111\u1EEBng n\xF3i nh\u01B0 v\u1EADy tr\u01B0\u1EDBc m\u1EB7t
      b\xE0 v\xE0 em."
    anchor: {fileID: 1108207947}
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    soundEffect: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - speakerName: "B\xE0:"
    content: "Th\xF4i n\xE0o. C\u01A1m ngu\u1ED9i r\u1ED3i, chuy\u1EC7n g\xEC c\u0169ng
      \u0111\u1EC3 l\xFAc b\xECnh t\u0129nh h\xE3y n\xF3i."
    anchor: {fileID: 889745936}
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    soundEffect: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - speakerName: 'Ba:'
    content: "Anh m\u1EC7t r\u1ED3i. Anh l\xEAn ph\xF2ng tr\u01B0\u1EDBc."
    anchor: {fileID: 1110933062}
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    soundEffect: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - speakerName: "Ch\u1ECB:"
    content: "Con c\u0169ng kh\xF4ng mu\u1ED1n \u0103n n\u1EEFa."
    anchor: {fileID: 940018621}
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    soundEffect: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - speakerName: "B\xE0:"
    content: "B\xE0 v\u1EC1 ph\xF2ng ngh\u1EC9. Hai \u0111\u1EE9a \u0111\u1EEBng
      n\xF3i n\u1EB7ng l\u1EDDi v\u1EDBi nhau th\xEAm n\u1EEFa."
    anchor: {fileID: 889745936}
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    soundEffect: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - speakerName: "M\u1EB9:"
    content: "M\u1EB9 xin l\u1ED7i v\xEC \u0111\u1EC3 con ph\u1EA3i nghe nh\u1EEFng
      chuy\u1EC7n n\xE0y. Con \u0103n th\xEAm \u0111i... m\u1EB9 mu\u1ED1n y\xEAn
      t\u0129nh m\u1ED9t l\xE1t."
    anchor: {fileID: 1108207947}
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    soundEffect: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - speakerName: 
    content: "C\u1EA3 nh\xE0 v\u1EABn \u1EDF r\u1EA5t g\u1EA7n, nh\u01B0ng ch\u1EB3ng
      ai ch\u1EA1m t\u1EDBi \u0111\u01B0\u1EE3c ai. C\xF2n m\xECnh l\u1EA1i ch\u1EC9
      bi\u1EBFt ng\u1ED3i im."
    anchor: {fileID: 785927213}
    speakerColor: {r: 0, g: 0, b: 0, a: 0}
    soundEffect: {fileID: 8300000, guid: 4a98bc20ec0919545988159a4ea5e5e3, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 14b8281c023dd1f4082fd3c70439b2b3, type: 3}
  playOnStart: 1
  backgroundImage: {fileID: 2095515895}
  backgroundFadeDuration: 3
  musicSource: {fileID: 1094330894}
  backgroundMusic: {fileID: 8300000, guid: cbb99ee27835ac34294cbffc8a4cb282, type: 3}
  soundEffectSource: {fileID: 612137757}
  onCutsceneFinished:
    m_PersistentCalls:
      m_Calls: []
