  m_Script: {fileID: 11500000, guid: bcf08ab01b6abd14b8185c53b46b6e85, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GrandmaDialogueTrigger
  talkToGrandmaNotice: {fileID: 1304621801}
  grandmaPanel: {fileID: 1783649043}
  grandmaDialogueText: {fileID: 1752702943}
  playerPanel: {fileID: 1069270666}
  playerDialogueText: {fileID: 1611636997}
  nextButton: {fileID: 1808243308}
  skipButton: {fileID: 1413882868}
  dialogueLines:
  - speaker: 1
    content: "B\xE0 \u01A1i, con t\xECm th\u1EA5y m\u1EA5y m\u1EA3nh \u1EA3nh d\u01B0\u1EDBi
      t\u1EE7 n\xEAn \u0111\xE3 gh\xE9p l\u1EA1i. \u0110\xE2y l\xE0 \u1EA3nh c\u1EE7a
      b\xE0 v\xE0 \xF4ng ph\u1EA3i kh\xF4ng?"
  - speaker: 0
    content: "\u1EEAm. H\xF4m tr\u01B0\u1EDBc b\xE0 l\u1EA5y \u1EA3nh ra lau, gi\u1EA5y
      c\u0169 qu\xE1 n\xEAn b\xE0 l\u1EE1 tay l\xE0m r\xE1ch. B\xE0 c\u1EE9 \u0111\u1EC3
      \u0111\xF3 m\xE3i."
  - speaker: 1
    content: "B\xE0 v\u1EABn nh\u1EDB \xF4ng nhi\u1EC1u l\u1EAFm ph\u1EA3i kh\xF4ng?"
  - speaker: 0
    content: "Nh\u1EDB ch\u1EE9. T\u1EEB ng\xE0y \xF4ng m\u1EA5t, c\u0103n ph\xF2ng
      v\u1EABn v\u1EADy nh\u01B0ng y\xEAn l\u1EB7ng h\u01A1n h\u1EB3n. Nhi\u1EC1u
      l\xFAc b\xE0 ch\u1EC9 mong c\xF3 ng\u01B0\u1EDDi ng\u1ED3i c\u1EA1nh n\xF3i
      v\xE0i c\xE2u."
  - speaker: 1
    content: "Con xin l\u1ED7i b\xE0. Con \u1EDF ngay trong nh\xE0 m\xE0 l\u1EA1i
      kh\xF4ng nh\u1EADn ra b\xE0 c\xF4 \u0111\u01A1n nh\u01B0 v\u1EADy."
  - speaker: 0
    content: "B\xE0 c\u0169ng xin l\u1ED7i v\xEC c\u1EE9 n\xF3i m\xECnh \u1ED5n.
      Th\u1EADt ra b\xE0 ch\u1EC9 mong c\u1EA3 nh\xE0 \u0111\u1EEBng tr\xE1nh nhau
      n\u1EEFa, c\xF3 th\u1EC3 ng\u1ED3i c\xF9ng m\u1ED9t b\xE0n nh\u01B0 ng\xE0y
      \xF4ng c\xF2n \u1EDF \u0111\xE2y."
  - speaker: 1
    content: "V\u1EADy m\xECnh b\u1EAFt \u0111\u1EA7u t\u1EEB h\xF4m nay nh\xE9.
      Con s\u1EBD \u1EDF l\u1EA1i nghe b\xE0 k\u1EC3 v\u1EC1 \xF4ng, r\u1ED3i t\u1ED1i
      nay con g\u1ECDi m\u1ECDi ng\u01B0\u1EDDi c\xF9ng xu\u1ED1ng \u0103n c\u01A1m."
  - speaker: 0
    content: "\u1EEAm. N\u1EBFu th\u1EA5y c\u1EA3 nh\xE0 ch\u1ECBu ng\u1ED3i l\u1EA1i
      v\u1EDBi nhau, ch\u1EAFc \xF4ng c\u1EE7a con c\u0169ng s\u1EBD vui l\u1EAFm."
  grandmaWithPhotoPanel: {fileID: 2111294218}
  darkRoomPanel: {fileID: 1484499188}
  brightRoomPanel: {fileID: 1802604512}
